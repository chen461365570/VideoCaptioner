<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:ui="using:FluentAvalonia.UI.Controls"
             xmlns:svc="using:VideoCaptioner.Avalonia.Services"
             x:Class="VideoCaptioner.Avalonia.Views.Home.TaskCreationInterface"
             DragDrop.AllowDrop="True"
             Background="Transparent">
  <UserControl.Styles>
    <!-- search_input: Win11 TextBox sized like the start button next to it -->
    <Style Selector="TextBox#SearchInput">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button#StartButton">
      <Setter Property="MinHeight" Value="36" />
      <Setter Property="MinWidth" Value="120" />
      <Setter Property="Padding" Value="14,0" />
      <Setter Property="HorizontalContentAlignment" Value="Center" />
      <Setter Property="VerticalContentAlignment" Value="Center" />
    </Style>
    <!-- footer links (查看日志 / 捐助) -->
    <Style Selector="HyperlinkButton.footerLink">
      <Setter Property="FontSize" Value="12" />
      <Setter Property="Padding" Value="8,4" />
    </Style>
  </UserControl.Styles>

  <!-- Workbench layout: import area on the left, pipeline settings on the right, version / links at the bottom -->
  <Grid RowDefinitions="*,Auto" RowSpacing="8">
    <Grid>
      <Grid.ColumnDefinitions>
        <ColumnDefinition Width="5*" MinWidth="340" />
        <ColumnDefinition Width="16" />
        <ColumnDefinition Width="3*" MinWidth="280" MaxWidth="380" />
      </Grid.ColumnDefinitions>

      <!-- left: import area (the whole page accepts drops) -->
      <Grid>
        <Border CornerRadius="8" Background="{DynamicResource CardBackgroundFillColorDefaultBrush}" />
        <Rectangle Name="DropZone" Classes="dropZone" />
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="32,28" VerticalAlignment="Center" MaxWidth="640">
            <Image Source="avares://VideoCaptioner/Assets/logo.png"
                   Width="64" Height="64" Stretch="Uniform" HorizontalAlignment="Center" />
            <TextBlock Text="{svc:Tr 卡卡字幕助手, Context=TaskCreationInterface}" FontSize="24" FontWeight="SemiBold"
                       HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Classes="caption" FontSize="13" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{svc:Tr 导入音视频文件或粘贴视频链接，自动完成转录、字幕优化翻译与视频合成, Context=TaskCreationInterface}" />

            <ui:SymbolIcon Symbol="Upload" FontSize="40" HorizontalAlignment="Center" Margin="0,36,0,0"
                           Foreground="{DynamicResource AccentTextFillColorPrimaryBrush}" />
            <TextBlock Text="{svc:Tr 拖拽音视频文件到此处, Context=TaskCreationInterface}"
                       FontSize="16" FontWeight="SemiBold" HorizontalAlignment="Center" Margin="0,12,0,4" />
            <TextBlock Classes="caption" HorizontalAlignment="Center" TextAlignment="Center" TextWrapping="Wrap"
                       Foreground="{DynamicResource TextFillColorSecondaryBrush}"
                       Text="{svc:Tr 也可以在下方输入视频 URL，或点击按钮选择本地文件, Context=TaskCreationInterface}" />

            <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8" Margin="0,20,0,0">
              <TextBox Name="SearchInput" Classes="clearButton"
                       Watermark="{svc:Tr 请拖拽文件或输入视频URL, Context=TaskCreationInterface}">
                <TextBox.InnerLeftContent>
                  <ui:SymbolIcon Symbol="Link" FontSize="16" Margin="10,0,0,0"
                                 Foreground="{DynamicResource TextFillColorSecondaryBrush}" />
                </TextBox.InnerLeftContent>
              </TextBox>
              <Button Name="StartButton" Grid.Column="1" Classes="accent">
                <StackPanel Orientation="Horizontal" Spacing="8">
                  <ui:SymbolIcon Name="StartIcon" Symbol="Folder" FontSize="16" />
                  <TextBlock Name="StartButtonText" Text="{svc:Tr 选择文件, Context=TaskCreationInterface}" VerticalAlignment="Center" />
                </StackPanel>
              </Button>
            </Grid>

            <!-- status: download progress -->
            <StackPanel Margin="0,16,0,0" Spacing="6">
              <ProgressBar Name="ProgressBar" Minimum="0" Maximum="100"
                           HorizontalAlignment="Stretch" IsVisible="False" />
              <TextBlock Name="StatusLabel" Classes="caption" Text="{svc:Tr 准备就绪, Context=TaskCreationInterface}"
                         HorizontalAlignment="Center" IsVisible="False" />
            </StackPanel>
          </StackPanel>
        </ScrollViewer>
      </Grid>

      <!-- right: what the pipeline will do with the imported file (the same config items as the settings page) -->
      <Border Grid.Column="2" Classes="card" Padding="0">
        <Border.Resources>
          <x:Double x:Key="ToggleSwitchThemeMinWidth">0</x:Double>
          <Thickness x:Key="ToggleSwitchTopHeaderMargin">0</Thickness>
        </Border.Resources>
        <ScrollViewer HorizontalScrollBarVisibility="Disabled">
          <StackPanel Margin="16" Spacing="12">
            <StackPanel Spacing="2">
              <TextBlock Classes="paneTitle" Text="{svc:Tr 流程设置, Context=TaskCreationInterface}" />
              <TextBlock Classes="caption" TextWrapping="Wrap"
                         Text="{svc:Tr 导入后将按以下配置依次执行, Context=TaskCreationInterface}" />
            </StackPanel>

            <StackPanel Spacing="6">
              <TextBlock Classes="caption" Text="{svc:Tr 转录模型, Context=TaskCreationInterface}" />
              <ComboBox Name="QuickModelCombo" HorizontalAlignment="Stretch" />
            </StackPanel>

            <Rectangle Classes="paneDivider" />

            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
              <TextBlock Classes="optLabel" Text="{svc:Tr 字幕校正, Context=TaskCreationInterface}" />
              <ToggleSwitch Name="QuickOptimizeSwitch" Grid.Column="1" Classes="vcCardSwitch" MinWidth="0"
                            OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
              <TextBlock Classes="optLabel" Text="{svc:Tr 字幕翻译, Context=TaskCreationInterface}" />
              <ToggleSwitch Name="QuickTranslateSwitch" Grid.Column="1" Classes="vcCardSwitch" MinWidth="0"
                            OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>
            <StackPanel Spacing="6">
              <TextBlock Classes="caption" Text="{svc:Tr 翻译语言, Context=TaskCreationInterface}" />
              <ComboBox Name="QuickLanguageCombo" HorizontalAlignment="Stretch" MaxDropDownHeight="320" />
            </StackPanel>

            <Rectangle Classes="paneDivider" />

            <Grid ColumnDefinitions="*,Auto" MinHeight="32">
              <TextBlock Classes="optLabel" Text="{svc:Tr 合成视频, Context=TaskCreationInterface}" />
              <ToggleSwitch Name="QuickVideoSwitch" Grid.Column="1" Classes="vcCardSwitch" MinWidth="0"
                            OnContent="{x:Null}" OffContent="{x:Null}" />
            </Grid>

            <Rectangle Classes="paneDivider" />

            <HyperlinkButton Name="MoreSettingsButton" Padding="0,4" HorizontalAlignment="Left">
              <StackPanel Orientation="Horizontal" Spacing="6">
                <ui:SymbolIcon Symbol="Settings" FontSize="14" />
                <TextBlock Text="{svc:Tr 更多设置, Context=TaskCreationInterface}" />
              </StackPanel>
            </HyperlinkButton>
          </StackPanel>
        </ScrollViewer>
      </Border>
    </Grid>

    <!-- footer: version + links -->
    <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Center" Spacing="4">
      <TextBlock Name="InfoLabel" Classes="caption" Foreground="{DynamicResource TextFillColorTertiaryBrush}"
                 VerticalAlignment="Center" Margin="0,0,8,0" />
      <HyperlinkButton Name="LogButton" Classes="footerLink" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:SymbolIcon Symbol="Document" FontSize="14" />
          <TextBlock Text="{svc:Tr 查看日志, Context=TaskCreationInterface}" />
        </StackPanel>
      </HyperlinkButton>
      <HyperlinkButton Name="DonateButton" Classes="footerLink" VerticalAlignment="Center">
        <StackPanel Orientation="Horizontal" Spacing="6">
          <ui:SymbolIcon Symbol="Like" FontSize="14" />
          <TextBlock Text="{svc:Tr 捐助, Context=TaskCreationInterface}" />
        </StackPanel>
      </HyperlinkButton>
    </StackPanel>
  </Grid>
</UserControl>
