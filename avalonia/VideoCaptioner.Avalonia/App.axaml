<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sty="using:FluentAvalonia.Styling"
             x:Class="VideoCaptioner.Avalonia.App"
             RequestedThemeVariant="Dark">
  <Application.Resources>
    <ResourceDictionary>
    <!-- Windows 11 system font (Segoe UI Variable, Microsoft YaHei UI for CJK) -->
    <FontFamily x:Key="ContentControlThemeFontFamily">Segoe UI Variable Text, Microsoft YaHei UI, Segoe UI, Microsoft YaHei</FontFamily>
    </ResourceDictionary>
  </Application.Resources>
  <Application.Styles>
    <sty:FluentAvaloniaTheme PreferSystemTheme="False" PreferUserAccentColor="False" />
    <StyleInclude Source="avares://VideoCaptioner/Styles/Controls.axaml" />
  </Application.Styles>
</Application>
